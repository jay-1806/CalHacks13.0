# ScreenTutor AI — Environment Configuration
# Copy to .env and fill in values as needed. Everything has a local fallback.

# Orchestrator Configuration
ORCHESTRATOR_PORT=4317
NODE_ENV=development

# Anthropic — tutoring answers and Co-drive (Claude computer use)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# fast (default) = Opus fast mode, ~2.5x faster at premium price; standard = cheaper
# CLAUDE_SPEED=fast
# off = no thinking (Sonnet 5.5 / Haiku 5.5 only)
# CLAUDE_THINKING=adaptive
CODRIVE_ENABLED=true
# Let approved Co-drive steps actually click/type on your desktop (Windows and macOS)
ENABLE_SAFE_ACTIONS=false

# Convex — learner memory, session history, response cache
# Run `npx convex dev` in services/orchestrator, copy the deployment URL here, then:
#   npx convex env set SCREENTUTOR_CONVEX_SECRET <same value as below>
CONVEX_URL=
SCREENTUTOR_CONVEX_SECRET=
MEMORY_ENABLED=true
TUTOR_CACHE_TTL_SECONDS=1800
RESEARCH_CACHE_TTL_SECONDS=3600

# Moss — semantic cache (reworded questions about the same screen)
SEMANTIC_CACHE_ENABLED=true
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# MOSS_MIN_SCORE=0.9

# Apify — Research mode (RAG Web Browser actor)
APIFY_API_TOKEN=
APIFY_ENABLED=true

# Fetch.ai — study-planner uAgent (run services/fetch-agent/agent.py)
FETCH_AGENTVERSE_ENABLED=false
FETCH_AGENT_URL=http://localhost:8001
FETCH_AGENT_SEED=

# Elastic — OpenTelemetry traces (managed OTLP endpoint)
ELASTIC_OTLP_ENDPOINT=
ELASTIC_API_KEY=
ELASTIC_ENABLED=true

# Sentry — error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false

# Cartesia — voice (Sonic streaming TTS + Ink streaming STT)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_ENABLED=true
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-2

# App Debug & Preferences
SCREENSHOT_STORAGE=none
PRIVACY_MODE_DEFAULT=true
DEBUG_COORDINATES=true

# Hold-to-dictate hotkey (Ctrl+Shift+E on Windows, Cmd+Shift+E on macOS).
# Default polls the keyboard so it works as push-to-talk. Set to `toggle` to use a
# press-to-start / press-to-stop global shortcut instead (useful if polling is blocked).
# SCREENTUTOR_HOTKEY_MODE=toggle
